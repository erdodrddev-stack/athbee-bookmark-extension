{
  "name": "bookdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch --mode development",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "vite build && $(test -x .venv/bin/python && echo .venv/bin/python || echo python3) tests/e2e/run.py"
  },
  "dependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "qrcode": "1.5.4",
    "vue": "3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "4.6.2",
    "vite": "4.5.5"
  }
}
