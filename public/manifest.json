{
  "manifest_version": 3,
  "name": "Bookdeck",
  "version": "0.1.0",
  "description": "Uma nova guia para acessar e organizar seus favoritos, com recomendações baseadas no seu histórico.",
  "permissions": ["bookmarks", "storage", "history", "tabs", "favicon", "search"],
  "optional_host_permissions": ["<all_urls>"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookdeck",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
